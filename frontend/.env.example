# Copy to frontend/.env for local development. Only fake values here; the deploy sets the
# real ones from GitHub Actions secrets (ADR-016).

# The API's address. Locally, the backend runs on port 8001 (README).
VITE_API_URL=http://localhost:8001

# Leonardo's phone number for the WhatsApp link. Leave it empty to hide the link.
VITE_CONTACT_PHONE=+00 0000 0000

# Address of the CV PDF (step 1.7). Leave it empty to hide the download button.
VITE_CV_URL=
