# Copy to backend/.env for local development. Only fake values here; real ones live in Railway.

# The commit being served, shown by /health. Deploys set it; locally it can stay "local".
GIT_SHA=local

# Origins of the site, as a JSON list. Production adds the real domain.
CORS_ORIGINS=["http://localhost:5180"]

# Folder with profile.yaml and the case studies. By default, the repo's content/.
# CONTENT_DIR=../content

# Request limits from docs/API.md.
MAX_MESSAGE_CHARS=6000
MAX_HISTORY_MESSAGES=20

# Contact details the assistant may give. Real ones live in Railway, never in the repo.
# CONTACT_EMAIL=name@example.com
# CONTACT_PHONE=+00 0 0000 0000

# OpenAI key, for the answers and the embeddings (ADR-019).
OPENAI_API_KEY=sk-fake-key-for-the-example

# Postgres with pgvector (Supabase: Connect > Session pooler). Percent-encode special characters.
DATABASE_URL=postgresql://postgres.project:password@aws-0-region.pooler.supabase.com:5432/postgres

# Embedding model; changing it re-embeds every chunk on the next ingestion.
# EMBEDDING_MODEL=text-embedding-3-small

# Provisional answer model and its limits (see config.py); the evals of step 5.7 pick the final one.
# ANSWER_MODEL=gpt-5.6-luna
# GUARDRAIL_MODEL=gpt-5.4-mini
# ANSWER_MAX_TOKENS=1000
# MAX_TOOL_ROUNDS=2
