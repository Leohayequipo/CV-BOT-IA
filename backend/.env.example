# Copy to backend/.env for local development. Only fake values here; real ones live in Railway.

# The commit being served, shown by /health. Deploys set it; locally it can stay "local".
GIT_SHA=local

# Origins of the site, as a JSON list. Production adds the real domain.
CORS_ORIGINS=["http://localhost:5180"]

# Folder with profile.yaml and the case studies. By default, the repo's content/.
# CONTENT_DIR=../content

# Request limits from docs/API.md.
MAX_MESSAGE_CHARS=6000
MAX_HISTORY_MESSAGES=20
